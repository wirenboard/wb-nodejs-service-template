#!/bin/sh
# Runs the tests before pushing.
# Enable once per clone:  git config core.hooksPath hooks
# Skip once:              git push --no-verify

if ! command -v node >/dev/null 2>&1; then
    echo "pre-push: node not found, tests skipped"
    exit 0
fi

# A clone that dropped the tests still gets a working hook instead of an error.
# The mask is wider than tests/ on purpose: node --test looks for *.test.js
# anywhere but node_modules.
if [ -z "$(find . -name '*.test.js' -not -path './node_modules/*' -print -quit 2>/dev/null)" ]; then
    echo "pre-push: no JS tests, skipping"
    exit 0
fi

echo "pre-push: node --test"
if ! node --test; then
    echo ""
    echo "pre-push: tests failed, push aborted."
    echo "To push anyway: git push --no-verify"
    exit 1
fi
